{
  "name": "aicodet",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "start": "expo start --lan",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "jest --runInBand",
    "check:dependencies": "expo install --check",
    "doctor": "expo-doctor",
    "export:android": "expo export --platform android",
    "build:android:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-android.ps1"
  },
  "dependencies": {
    "@expo/dom-webview": "58.0.2",
    "@expo/log-box": "58.0.15",
    "@expo/metro-runtime": "58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-font": "58.0.11",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-expo": "58.0.4",
    "expo-doctor": "1.21.6",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/src/**/*.test.tsx"
    ]
  }
}
